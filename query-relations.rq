PREFIX rfpo: <https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#>
PREFIX fpo: <https://github.com/johnBradley501/FPO/raw/master/fpo.owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Produce a source-aware list of observed source assertions (not a verified SNA edge list).
SELECT ?factoid ?actant1 ?actant2 ?relation ?source ?locus
WHERE {
    ?factoid a rfpo:BinaryRelationalFactoid ;
      rfpo:hasActant1Reference/fpo:referencesPerson ?actant1 ;
      rfpo:hasActant2Reference/fpo:referencesPerson ?actant2 ;
      rfpo:assertsConnectionType ?relationConcept ;
      fpo:sourcedFrom ?citation .
    ?relationConcept skos:prefLabel ?relation .
    ?citation fpo:fromSource ?source ;
      fpo:hasPlaceInSource ?locus .
}
ORDER BY ?factoid
