<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#assertsConnectionType">
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#RelationalFactoid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">asserts type of connection N</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled historical relation category whose definition specifies the meaning and direction of A1 -&gt; A2. It is a *type of source assertion*, not an asserted direct person-person RDF property.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl">
    <rdfs:label xml:lang="en">Relational factoid extension of Bradley's FPO, working draft 0.1</rdfs:label>
    <dcterms:creator>Hervin Fernández Aceves</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-22</dcterms:created>
    <dcterms:description xml:lang="en">A conservative OWL extension representing a source-grounded directed connection N between two actants A1 and A2, without asserting an unqualified historical relationship.</dcterms:description>
    <dcterms:source rdf:resource="https://github.com/johnBradley501/FPO"/>
    <dcterms:source rdf:resource="https://www.academia.edu/24429003/The_Uncharted_Networks_of_a_Chartered_Territory_Diplomatic_Evidence_and_Relational_Sociology_for_the_Norman_Kingdom_of_Sicily"/>
    <owl:versionInfo>0.1-working-reconstruction</owl:versionInfo>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#relationTime">
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#RelationalFactoid"/>
    <rdfs:range rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#DateRange"/>
    <rdfs:label xml:lang="en">claimed relation period (distinct from source date)</rdfs:label>
    <rdfs:comment xml:lang="en">The time for which a source asserts the relation, DISTINCT from when the documentary assertion was written (fpo:hasDateAssertionMade). For specialised state/event factoids, the FPO dateForAssertion/occurredOn properties may also be used appropriately.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#hasAttributionSubjectReference">
    <rdfs:subPropertyOf rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#hasReference"/>
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#AttributionalFactoid"/>
    <rdfs:range rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#PersonReference"/>
    <rdfs:label xml:lang="en">has attributional subject reference</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#hasActant2Reference">
    <rdfs:subPropertyOf rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#hasReference"/>
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#BinaryRelationalFactoid"/>
    <rdfs:range rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#PersonReference"/>
    <rdfs:label xml:lang="en">has A2 person reference</rdfs:label>
    <rdfs:comment xml:lang="en">The source-occurrence reference to the second actant. The ordered slots must not be presumed symmetric.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#assertsAttributeType">
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#AttributionalFactoid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">asserts attribute F</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#hasActant1Reference">
    <rdfs:subPropertyOf rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#hasReference"/>
    <rdfs:domain rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#BinaryRelationalFactoid"/>
    <rdfs:range rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#PersonReference"/>
    <rdfs:label xml:lang="en">has A1 person reference</rdfs:label>
    <rdfs:comment xml:lang="en">The source-occurrence reference to the first actant; A1's specific function is held separately in fpo:hasRole.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#editorialInterpretation">
    <rdfs:domain rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#Factoid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">editorial interpretation (not source wording)</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#evidenceExcerpt">
    <rdfs:domain rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#Factoid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">verbatim evidence excerpt</rdfs:label>
    <rdfs:comment xml:lang="en">An excerpt from the cited source, with original wording and language preserved. A transcription should be checked against its edition or manuscript.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#RelationalFactoid">
    <rdfs:subClassOf rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#Factoid"/>
    <rdfs:label xml:lang="en">Relational factoid</rdfs:label>
    <rdfs:comment xml:lang="en">A documentary assertion interpreting a connection between historical actants. NOT an established relationship asserted directly between persons. Unlike FPO RelationshipFactoid, this broad class also permits transaction event factoids.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#AttributionalFactoid">
    <rdfs:subClassOf rdf:resource="https://github.com/johnBradley501/FPO/raw/master/fpo.owl#Factoid"/>
    <rdfs:label xml:lang="en">Attributional factoid</rdfs:label>
    <rdfs:comment xml:lang="en">A source-grounded claim of an attribute about an actant, corresponding to the attributional formulation in Fernández-Aceves's presentation. This first draft does not constrain attribute values.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#BinaryRelationalFactoid">
    <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/falcando/relational-factoid-ontology/main/relational-factoid-ontology.ttl#RelationalFactoid"/>
    <rdfs:label xml:lang="en">Binary relational factoid</rdfs:label>
    <rdfs:comment xml:lang="en">A relational factoid with structurally distinguished A1 and A2 references. Additional witnesses or locations may still use fpo:hasReference; roles specify their participation.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
